{
  "name": "zhiye-ai-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "node --use-env-proxy --env-file-if-exists=.env backend/server.mjs",
    "build": "tsc -b && vite build",
    "start": "node --use-env-proxy --env-file-if-exists=.env backend/server.mjs",
    "open": "node scripts/launch.mjs",
    "package:windows": "npm run build && node --use-env-proxy scripts/package-windows.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test backend/tests/*.test.mjs scripts/tests/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "@playwright/test": "^1.51.0"
  }
}
